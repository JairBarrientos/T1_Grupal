<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F3F9F7">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Veterinarios / Asistentes"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#235347"/>

    <ListView
        android:id="@+id/lvPersonal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:divider="#D7E8E6"
        android:dividerHeight="8dp"/>

    <Button
        android:id="@+id/btnAgregarPersonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar Personal"
        android:layout_marginTop="12dp"
        android:backgroundTint="#235347"
        android:textColor="#FFFFFF"
        android:minHeight="52dp"/>

</LinearLayout>
